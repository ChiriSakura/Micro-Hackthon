# Generated experiment artifacts
FAST/runs/
FAST/artifacts/
FAST/checkpoints/
*.log

# scala-cli build state and BSP metadata under FAST/hardware. Regenerated on
# every elaboration; the sources and the Elaborate entry point are the inputs.
.scala-build/
.bsp/

# Temporary location used while constructing the monorepo index
/.nested-git-metadata/

# Rendered CHIA cluster config: generated by FAST/scripts/gcp_render_cluster.py
# from the .example template. It interpolates real paths at load time, so it is
# machine-specific even though it stores no credentials of its own.
FAST/configs/chia/fast-gcp.yaml
FAST/configs/chia/fast-gcp-head.yaml
